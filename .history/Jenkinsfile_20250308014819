pipeline {
    agent any
    
    environment {
        // Docker Hub credentials (ID: docker-pass)
        DOCKER_CREDS = credentials('docker-pass')
        
        // Docker Hub repository for the image (update if needed)
        DOCKER_REPO = "ranaalshehri/swe645-hw2-student-survey-amd64"
        
        // Maven settings: WAR file should be generated in target directory
        WAR_OUTPUT = "target/SWE645_HW2_StudentSurvey.war"
    }
    
    stages {
        stage('Checkout') {
            steps {
                // Check out the repository (Jenkins will use the branch specified in the job configuration)
                checkout scm
            }
        }
        
        stage('Build WAR') {
            steps {
                // Run Maven to build the project. This should produce the WAR file.
                sh "mvn clean package"
                
                // (Optional) Verify that the WAR file exists and show its size.
                sh "ls -lh ${WAR_OUTPUT}"
            }
        }
        
        stage('Build Docker Image') {
            steps {
                script {
                    // Build the Docker image using the Dockerfile in the repository root.
                    // The Dockerfile should have a COPY command like:
                    // COPY target/SWE645_HW2_StudentSurvey.war /usr/local/tomcat/webapps/StudentSurvey.war
                    sh "docker build -t ${DOCKER_REPO}:latest ."
                }
            }
        }
        
        stage('Push Docker Image') {
            steps {
                script {
                    // Log in to Docker Hub using Jenkins credentials and push the image.
                    sh """
                      docker login -u \$DOCKER_CREDS_USR -p \$DOCKER_CREDS_PSW
                      docker push ${DOCKER_REPO}:latest
                    """
                }
            }
        }
    }
    
    post {
        always {
            echo 'Cleaning up workspace...'
        }
        success {
            echo 'Part 1 completed: Docker image built and pushed successfully.'
        }
        failure {
            echo 'Build failed. Please check the console output for errors.'
        }
    }
}
