pipeline {
    agent any
    
    environment {
        // Docker Hub credentials stored in Jenkins with ID 'docker-pass'
        DOCKER_CRED = credentials('docker-pass')
        
        // Your Docker Hub repo for the final image
        DOCKER_REPO = "ranaalshehri/swe645-hw2-student-survey-amd64"
        
        // Kubernetes namespace where you want to deploy
        K8S_NAMESPACE = "default"
    }
    
    stages {
        stage('Checkout Source') {
            steps {
                // Clones the repo from the branch you configured in Jenkins job (e.g., Kris branch)
                checkout scm
            }
        }
        
        stage('Build Docker Image') {
            steps {
                script {
                    // Build image using Dockerfile in the current directory
                    sh """
                      docker build -t ${DOCKER_REPO}:latest .
                    """
                }
            }
        }
        
        stage('Push Docker Image') {
            steps {
                script {
                    // Docker login and push the image to your Docker Hub repo
                    sh """
                      docker login -u \$DOCKER_CRED_USR -p \$DOCKER_CRED_PSW
                      docker push ${DOCKER_REPO}:latest
                    """
                }
            }
        }
        
        stage('Deploy to Kubernetes') {
            steps {
                script {
                    // Apply your Kubernetes YAML files to deploy/update the application
                    sh """
                      kubectl apply -f "YAML Files/survey-deployment.yaml" -n ${K8S_NAMESPACE}
                      kubectl apply -f "YAML Files/survey-deployment-service.yaml" -n ${K8S_NAMESPACE}
                    """
                }
            }
        }
    }
    
    post {
        always {
            echo 'Cleaning up workspace...'
        }
        success {
            echo 'Deployment successful!'
        }
        failure {
            echo 'Deployment failed.'
        }
    }
}
