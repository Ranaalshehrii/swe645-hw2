pipeline {
    agent any
    environment {
        DOCKER_IMAGE = "ranaalshehri/swe645-hw2-student-survey-amd64"
        DOCKER_CREDENTIALS_ID = "docker-pass"
        KUBECONFIG_CRED_ID = "kubeconfig-id"
        K8S_NAMESPACE = "default"
    }
    stages {
        stage('Build Docker Image') {
            steps {
                sh "docker build -t ${DOCKER_IMAGE}:latest ."
            }
        }
        stage('Push Docker Image') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', "${DOCKER_CREDENTIALS_ID}") {
                        docker.image("${DOCKER_IMAGE}:latest").push()
                    }
                }
            }
        }
        stage('Deploy to Kubernetes') {
            steps {
                withKubeConfig([credentialsId: "${KUBECONFIG_CRED_ID}"]) {
                    sh "kubectl rollout restart deployment studentsurvey -n ${K8S_NAMESPACE}"
                }
            }
        }
    }
    post {
        always {
            echo 'Cleaning up...'
        }
        success {
            echo 'Deployment successful!'
        }
        failure {
            echo 'Deployment failed.'
        }
    }
}
